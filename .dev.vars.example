# Wyreup Pages Functions — local development settings.
#
# Copy this file to .dev.vars (gitignored) for local development.
# `wrangler pages dev` reads .dev.vars automatically.
#
# 32-byte hex. Generate with:  openssl rand -hex 32
SESSION_SECRET=""

# Optional: override public origin for local development.
APP_ORIGIN="http://localhost:8788"
