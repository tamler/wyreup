{
  "name": "wyreup-monorepo",
  "version": "0.0.0",
  "private": true,
  "description": "Wyreup — free, privacy-first tool library",
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@10.34.5",
  "engines": {
    "node": "^22.13.0 || ^24.0.0 || >=26.0.0"
  },
  "scripts": {
    "build": "turbo run build",
    "test": "turbo run test --concurrency=2",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "typecheck:functions": "tsc --noEmit -p functions/tsconfig.json",
    "test:functions": "vitest run functions",
    "check:consumers": "node tools/check-package-consumers.mjs",
    "release:pack": "node tools/prepare-release-artifacts.mjs",
    "release:verify": "node tools/check-release-artifacts.mjs artifacts",
    "release:publish": "node tools/check-release-artifacts.mjs artifacts --prepare-publish && changeset publish --from-pack-dir artifacts/ready && node tools/check-release-artifacts.mjs artifacts --registry",
    "dev": "turbo run dev --parallel",
    "dev:pages": "pnpm --filter @wyreup/web build && wrangler pages dev packages/web/dist",
    "db:apply:local": "wrangler d1 migrations apply wyreup-prod --local",
    "db:apply:remote": "wrangler d1 migrations apply wyreup-prod --remote",
    "clean": "turbo run clean && rm -rf node_modules .turbo",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint:root": "eslint .",
    "test:root": "vitest run",
    "check:packages": "node tools/check-package-entrypoints.mjs",
    "test:watch": "vitest",
    "changeset": "changeset",
    "changeset:version": "changeset version",
    "changeset:publish": "changeset publish"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@changesets/cli": "^3.0.3",
    "@eslint/js": "^9.39.5",
    "@types/node": "^22.20.5",
    "@vitest/coverage-v8": "^4.1.12",
    "esbuild": "^0.28.2",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "js-yaml": "4.3.2",
    "parse5": "8.0.0",
    "playwright": "^1.64.0",
    "prettier": "^3.9.9",
    "semver": "7.8.5",
    "tar": "^7.5.22",
    "turbo": "^2.11.7",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.71.1",
    "vitest": "^4.1.12",
    "wrangler": "^4.148.0"
  },
  "pnpm": {
    "overrides": {
      "astro@7.3.7>http-cache-semantics": "-",
      "jspdf>dompurify": "^3.4.17",
      "express-rate-limit>ip-address": "^10.7.4",
      "miniflare>sharp": "^0.35.5",
      "tsup>esbuild": "^0.28.2",
      "express@5.2.1>body-parser": "2.4.0",
      "express@5.2.1>qs": "6.16.1",
      "ajv@8.20.0>fast-uri": "3.1.9",
      "unifont@0.7.5>undici": "8.12.2",
      "miniflare@5.20261006.0-alpha>undici": "7.30.1",
      "@rollup/plugin-terser@1.0.0>serialize-javascript": "7.1.3",
      "archiver-utils@5.0.2>glob": "14.0.2",
      "workbox-build@7.4.1>glob": "14.0.2",
      "readdir-glob@1.1.3>minimatch": "11.0.1",
      "filelist@1.0.6>minimatch": "11.0.1",
      "@eslint/config-array@0.23.5>minimatch": "11.0.1",
      "@typescript-eslint/typescript-estree@8.71.1>minimatch": "11.0.1",
      "eslint@10.12.0>minimatch": "11.0.1",
      "glob@14.0.2>minimatch": "11.0.1"
    },
    "patchedDependencies": {
      "astro@7.3.7": "patches/astro@7.3.7.patch",
      "pdfjs-dist@6.4.299": "patches/pdfjs-dist@6.4.299.patch"
    },
    "onlyBuiltDependencies": [
      "esbuild",
      "workerd"
    ],
    "ignoredBuiltDependencies": [
      "core-js",
      "protobufjs",
      "tesseract.js"
    ]
  }
}
