{
  "name": "wyreup-monorepo",
  "version": "0.0.0",
  "private": true,
  "description": "Wyreup — free, privacy-first tool library",
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@10.34.5",
  "engines": {
    "node": "^22.13.0 || ^24.0.0 || >=26.0.0"
  },
  "scripts": {
    "build": "turbo run build",
    "test": "turbo run test --concurrency=2",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "typecheck:functions": "tsc --noEmit -p functions/tsconfig.json",
    "test:functions": "vitest run functions",
    "check:consumers": "node tools/check-package-consumers.mjs",
    "release:pack": "node tools/prepare-release-artifacts.mjs",
    "release:verify": "node tools/check-release-artifacts.mjs artifacts",
    "release:publish": "node tools/check-release-artifacts.mjs artifacts --prepare-publish && changeset publish --from-pack-dir artifacts/ready && node tools/check-release-artifacts.mjs artifacts --registry",
    "dev": "turbo run dev --parallel",
    "dev:pages": "pnpm --filter @wyreup/web build && wrangler pages dev packages/web/dist",
    "db:apply:local": "wrangler d1 migrations apply wyreup-prod --local",
    "db:apply:remote": "wrangler d1 migrations apply wyreup-prod --remote",
    "clean": "turbo run clean && rm -rf node_modules .turbo",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint:root": "eslint .",
    "test:root": "vitest run",
    "check:packages": "node tools/check-package-entrypoints.mjs",
    "test:watch": "vitest",
    "changeset": "changeset",
    "changeset:version": "changeset version",
    "changeset:publish": "changeset publish"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@changesets/cli": "^3.0.3",
    "@eslint/js": "^9.39.5",
    "@types/node": "^22.20.5",
    "@vitest/coverage-v8": "^4.1.11",
    "esbuild": "^0.28.2",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "playwright": "^1.64.0",
    "prettier": "^3.9.9",
    "tar": "^7.5.22",
    "turbo": "^2.11.7",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.71.1",
    "vitest": "^4.1.11",
    "wrangler": "^4.148.0"
  },
  "pnpm": {
    "overrides": {
      "astro@7.3.7>http-cache-semantics": "-",
      "miniflare>sharp": "^0.35.5",
      "tsup>esbuild": "^0.28.2"
    },
    "patchedDependencies": {
      "astro@7.3.7": "patches/astro@7.3.7.patch"
    },
    "onlyBuiltDependencies": [
      "esbuild",
      "workerd"
    ],
    "ignoredBuiltDependencies": [
      "core-js",
      "protobufjs",
      "tesseract.js"
    ]
  }
}
