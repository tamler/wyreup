{
  "name": "@wyreup/web",
  "version": "0.0.0",
  "description": "Wyreup web app — wyreup.com",
  "license": "MIT",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "astro dev",
    "build": "node scripts/copy-skills.mjs && astro build",
    "preview": "astro preview",
    "test": "vitest run --passWithNoTests",
    "lint": "eslint src",
    "check:pwa": "node scripts/check-pwa.mjs",
    "check:remote-cache": "node --test scripts/check-remote-cache.mjs",
    "check:pgp": "node scripts/check-pgp.mjs",
    "typecheck": "astro check && tsc --noEmit",
    "clean": "rm -rf dist .astro .turbo",
    "build:og": "node scripts/build-og-image.mjs"
  },
  "dependencies": {
    "@astrojs/sitemap": "^3.7.4",
    "@wyreup/core": "workspace:*",
    "astro": "7.3.7",
    "dompurify": "^3.4.16",
    "fuse.js": "^7.5.0",
    "jszip": "^3.10.2",
    "pdfjs-dist": "^6.4.299"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@astrojs/svelte": "^9.0.1",
    "@resvg/resvg-js": "^2.6.2",
    "@types/node": "^22.20.5",
    "svelte": "^5.57.2",
    "typescript": "^5.9.3",
    "vite": "^8.3.4",
    "vitest": "^4.1.11",
    "workbox-build": "^7.4.1",
    "workbox-expiration": "^7.4.1",
    "workbox-precaching": "^7.4.1",
    "workbox-routing": "^7.4.1",
    "workbox-strategies": "^7.4.1"
  }
}
