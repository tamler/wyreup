---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { createDefaultRegistry } from '@wyreup/core';
import { TOOL_PAGE_METADATA } from '../../lib/seo';

export async function getStaticPaths() {
  const registry = createDefaultRegistry();
  const allTools = Array.from(registry.toolsById.values());
  // Include both primary `category` and additional `categories[]` so a
  // tool can surface under multiple buckets (e.g. geo tools live under
  // both 'convert' and 'geo'). Mirrors the filter logic in tools.astro.
  const categories = [
    ...new Set(allTools.flatMap((t) => [t.category, ...(t.categories ?? [])])),
  ].sort();

  // Hand-written SEO intro copy per category (Signal voice: terse, no exclamation marks)
  const categoryMeta: Record<string, { displayName: string; h1: string; sub: string; description: string; intro: string }> = {
    image: {
      displayName: 'Image',
      h1: 'Image editing and conversion tools',
      sub: 'Compress, convert, resize, blur faces and strip metadata.',
      description: 'Find image tools to compress, convert and resize photos, strip EXIF metadata, blur faces and remove backgrounds. Check each tool for formats and execution details.',
      intro: `Compress a photo for email. Convert HEIC to JPG. Strip camera metadata and GPS coordinates before sharing. Blur detected faces in a crowd shot and review the result. Resize for the web. Choose the tool that matches your file and destination.

Every tool in this category handles common image tasks that used to require desktop software or paid cloud services. Drop a file, pick settings, download the result.`,
    },
    pdf: {
      displayName: 'PDF',
      h1: 'PDF editing, extraction and compression tools',
      sub: 'Merge, split, compress, redact and extract PDF content.',
      description: 'Browse free PDF tools to merge, split, rotate, encrypt, redact and inspect forms. Check supported operations and limits before processing a document.',
      intro: `Split a long scan into single pages. Merge contracts into one file. Redact sensitive sections before sending. Encrypt with a password. Add page numbers to a submission. Rotate a mis-scanned page. Check the selected tool's limits and inspect the result before sending a document.

PDF tools cover document structure, visible pages and extracted content. Choose a tool according to the operation and data flow you need.`,
    },
    media: {
      displayName: 'Media',
      h1: 'Audio and video conversion tools',
      sub: 'Trim, convert formats, extract audio and compress media.',
      description: 'Convert, compress, trim and edit video and audio files. Check supported codecs, browser requirements and execution details for the selected tool.',
      intro: `Convert a video to a different format. Trim a clip to the right length. Extract audio from a recording. Compress a large video for sharing. Add subtitles directly to the video file. Speed up or slow down footage. Codec support and memory requirements vary by operation.

Video and audio work have historically required heavy desktop software. These tools handle the common cases without installation.`,
    },
    audio: {
      displayName: 'Audio',
      h1: 'Audio enhancement and processing tools',
      sub: 'Upscale low-quality recordings. Convert between formats.',
      description: 'Find audio tools for enhancement, noise reduction and format conversion. Compare requirements and free or hosted execution before running a recording.',
      intro: `Enhance a voice recording with noise reduction. Clean up audio before transcription or sharing. Compare the selected tool's requirements and listen to the result; quality depends on the recording.

Clear audio matters for transcription accuracy, accessibility, and professional output. These tools handle the preprocessing step that makes everything downstream easier.`,
    },
    convert: {
      displayName: 'Convert',
      h1: 'File format conversion tools',
      sub: 'Images, PDFs, documents, data.',
      description: 'Convert images, documents, spreadsheets, markup and data between formats. Select a converter that supports your input and intended output.',
      intro: `Convert Markdown to HTML for a CMS. Transform CSV to JSON for an API. Turn an SVG into a PNG. Convert spreadsheet formats without Excel. Encode and decode Base64. Convert HTML back to readable Markdown. Check supported inputs and output settings before converting.

Format conversion is one of the most frequent developer and document tasks. These tools cover the common cases quickly.`,
    },
    edit: {
      displayName: 'Edit',
      h1: 'Image and PDF editing tools',
      sub: 'Crop, rotate, flip, watermark. No signup.',
      description: 'Crop, rotate, flip, watermark and adjust images and PDFs. Browse free browser tools and optional hosted PRO editing tools.',
      intro: `Crop an image to a specific region. Rotate a mis-oriented photo. Apply a grayscale or sepia filter. Add a watermark to protect your work. Extract or delete specific pages from a PDF. Crop a PDF to a region. These are the edit operations you reach for before sending a file on.

Keep the source file and inspect the edited copy before replacing or publishing an asset.`,
    },
    optimize: {
      displayName: 'Optimize',
      h1: 'Image, PDF and SVG optimization tools',
      sub: 'Compress files and compare quality with file size.',
      description: 'Compress images and PDFs or optimize SVGs. Savings vary by source; lossy image re-encoding can change quality. Inspect the output before using it.',
      intro: `Compress a JPEG before attaching it to an email. Shrink a PDF for a file upload limit. Optimize an SVG for a webpage. Upscale a small image to double its resolution using AI. File size reduction matters for email, storage, and web performance.

Compression methods differ by file type. Image and PDF tools may re-encode image data with a quality tradeoff; already compressed sources may not shrink. SVG optimization changes markup. Inspect the result for your intended use.`,
    },
    privacy: {
      displayName: 'Privacy',
      h1: 'Photo metadata, face blur and file privacy tools',
      sub: 'Strip metadata, encrypt PDFs, blur faces, redact regions.',
      description: "Remove photo EXIF and GPS metadata, blur detected faces, redact regions and encrypt files. Review limitations and each tool's data flow before sharing.",
      intro: `Strip GPS and camera data from a photo before posting. Blur detected faces in a group shot, then check for missed people. Encrypt a file with PGP before sending. Verify a PGP signature on a received document. Choose the operation that addresses the information you need to protect.

Metadata removal and face blur do not guarantee anonymity. Review visible clues, output quality and the selected tool's execution details. Source code is available for inspection.`,
    },
    create: {
      displayName: 'Create',
      h1: 'QR code, password and file generation tools',
      sub: 'QR codes, UUIDs, passwords, lorem ipsum.',
      description: 'Generate QR codes, passwords, UUIDs, favicons, barcodes and other outputs. Choose the matching tool and check its input requirements.',
      intro: `Generate a QR code for a URL or contact card. Create a secure random password. Produce a UUID for a database record. Build a favicon set from an image. Generate a barcode for a product label. Produce lorem ipsum placeholder text. Create a slug for a URL.

Generation tools create outputs from text, settings or a source file. Check the selected tool's formats and execution requirements.`,
    },
    inspect: {
      displayName: 'Inspect',
      h1: 'File inspection and comparison tools',
      sub: 'Dimensions, metadata, hashes, structure.',
      description: 'Examine file properties, compare images and text, decode tokens and analyze color. Check each inspection tool\'s output and execution details.',
      intro: `Check an image's format, dimensions and file size. Diff two images to find pixel-level differences. Parse a JWT without a decoder service. Test a regex against sample input. Count words in a document. Inspect a ZIP before extracting it. Convert color values between supported formats.

Inspection tools tell you what is in a file or string without modifying it. Useful for debugging, verification, and auditing.`,
    },
    export: {
      displayName: 'Export',
      h1: 'Text, OCR and data extraction tools',
      sub: 'Extract text, tables, pages, or convert to simpler formats.',
      description: 'Extract text, run OCR and export structured data from images and documents. Check supported formats and local or hosted execution for each tool.',
      intro: `Extract plain text from a PDF for further processing. Run OCR on a scanned image or document to get searchable text. Extract tables from a PDF into structured JSON. Pull audio from a video file. Export data to a format your next tool expects.

Extraction is the first step in many document workflows. Getting clean output out of a file lets you process it further without manual copying.`,
    },
    text: {
      displayName: 'Text',
      h1: 'Text analysis and transformation tools',
      sub: 'Format JSON, decode JWTs, diff text, count words.',
      description: 'Analyze, translate, summarize and transform text. Compare free tools and optional hosted models, with data flow and requirements shown on each tool page.',
      intro: `Analyze the sentiment of a review or feedback batch. Run named entity recognition to extract names, places, and organizations. Summarize a long document. Translate text between languages. Compute readability scores for content targeting. Get word and character statistics. Calculate token counts for LLM input planning.

Text tools use different models and algorithms. Compare the selected tool's capabilities and execution details, then verify its output before using it.`,
    },
    dev: {
      displayName: 'Dev',
      h1: 'Developer text and data tools',
      sub: 'Format JSON, decode JWTs, diff text, count words.',
      description: 'Format JSON, YAML, SQL, CSS, and HTML. Convert data formats. Decode tokens and parse cron expressions.',
      intro: `Format a minified JSON payload for reading. Convert CSV to JSON for an API call. Decode a JWT to inspect its claims. Parse a cron expression to verify its schedule. Format SQL before committing it. Convert between number bases. Escape and unescape strings. Count tokens in a prompt before sending it to an LLM.

Developer utility tools handle the small-but-frequent text transformation tasks that slow down workflows when you have to search for a tool each time.`,
    },
    finance: {
      displayName: 'Finance',
      h1: 'Financial calculator tools',
      sub: 'Compound interest, dollar-cost averaging, percentages, dates.',
      description: 'Calculate compound interest, model DCA investment strategies, and run financial projections in your browser.',
      intro: `Calculate how a lump sum grows under compound interest over time. Model a dollar-cost averaging investment plan across different contribution schedules. Run financial projections with different rate assumptions. All computation runs locally — no financial data leaves your device.

Financial calculators are a common daily-use tool for investors and planners. These cover the core quantitative cases without requiring a spreadsheet or a financial platform account.`,
    },
    archive: {
      displayName: 'Archive',
      h1: 'ZIP archive creation and extraction tools',
      sub: 'Create, extract, inspect archives.',
      description: 'Create ZIP archives, extract ZIP files, and inspect archive contents — all in your browser.',
      intro: `Create a ZIP archive from multiple files for a single download or email attachment. Extract the contents of a ZIP without installing software. Inspect a ZIP to see its file list and metadata before extracting. Archive tools are the last step before sharing a batch of files and the first step when receiving one.

All archive operations run in-browser using compression APIs. No files are sent to an external server.`,
    },
    geo: {
      displayName: 'Geo',
      h1: 'Geospatial data conversion tools',
      sub: 'GeoJSON, KML, GPX, Shapefile, and the rest of the GIS family.',
      description: 'Convert between GeoJSON, KML, GPX, Shapefile, GeoPackage, FlatGeobuf, TopoJSON, and CSV. Every conversion runs in your browser.',
      intro: `Turn a Google Earth KML into GeoJSON for a web map. Convert a Strava GPX track to KML to visualize the ride. Pull a CSV of latitude/longitude points into a proper GeoJSON FeatureCollection. Open a zipped ESRI Shapefile from a GIS portal without ArcGIS or QGIS installed. Bridge a GeoJSON layer into GeoPackage or FlatGeobuf for the next tool downstream. Every geospatial conversion runs locally — your map data never uploads to a service.

The focused tools handle KML to GeoJSON, GPX to KML, Shapefile to GeoJSON and CSV to GeoJSON. The broader Convert Geospatial Data tool wraps GDAL/OGR via WebAssembly for supported vector formats; check its format options and input requirements.`,
    },
  };

  return categories.map((cat) => {
    const catTools = allTools.filter(
      (t) => t.category === cat || (t.categories ?? []).includes(cat),
    );
    const meta = categoryMeta[cat] ?? {
      displayName: cat.charAt(0).toUpperCase() + cat.slice(1),
      h1: `${cat.charAt(0).toUpperCase() + cat.slice(1)} tools.`,
      sub: `Browse ${cat} tools and choose the operation you need.`,
      description: `Browse ${cat} tools. Check each tool's supported files, requirements and execution details.`,
      intro: `These tools handle common ${cat} tasks directly in your browser.`,
    };
    const hasHostedTools = catTools.some((tool) => tool.cost === 'credit');
    const executionNote = hasHostedTools
      ? 'This category includes free browser tools and hosted PRO tools. Hosted tools explain what is sent before you run them. Local AI tools may download models during setup.'
      : 'These free tools execute in your browser. Setup can download code, codecs or models; network-related tasks can make requests. Check each tool for requirements and offline availability.';

    // Related categories: pick up to 4 others that share tools with similar output mimes
    const catMimes = new Set(catTools.map((t) => t.output?.mime));
    const relatedCats = categories
      .filter((c) => c !== cat)
      .filter((c) => {
        const cTools = allTools.filter(
          (t) => t.category === c || (t.categories ?? []).includes(c),
        );
        return cTools.some((t) => catMimes.has(t.output?.mime));
      })
      .slice(0, 4);

    return {
      params: { slug: cat },
      props: {
        cat,
        displayName: meta.displayName,
        catH1: meta.h1,
        catSub: meta.sub,
        metaDescription: meta.description,
        intro: meta.intro,
        executionNote,
        catTools: catTools.map((t) => ({
          id: t.id,
          name: t.name,
          category: t.category,
          description: TOOL_PAGE_METADATA[t.id]?.description ?? t.description,
        })),
        relatedCats,
        allCategories: categories,
      },
    };
  });
}

const { displayName, catH1, catSub, metaDescription, intro, executionNote, catTools, relatedCats } = Astro.props;
const introParas = intro.split('\n\n').filter(Boolean);
---

<BaseLayout
  title={`${catH1} — Wyreup`}
  description={metaDescription}
  ogDescription={metaDescription}
  surfaceMode="welcome"
>
  <section class="category-page">
    <div class="container">
      <!-- Breadcrumb -->
      <nav class="breadcrumb" aria-label="Breadcrumb">
        <a href="/" class="breadcrumb__link">Wyreup</a>
        <span class="breadcrumb__sep" aria-hidden="true">/</span>
        <a href="/tools" class="breadcrumb__link">Tools</a>
        <span class="breadcrumb__sep" aria-hidden="true">/</span>
        <span class="breadcrumb__current" aria-current="page">{displayName}</span>
      </nav>

      <!-- Hero -->
      <header class="cat-hero">
        <h1 class="cat-title">{catH1}</h1>
        <p class="cat-sub">{catSub}</p>
        <div class="cat-intro">
          {introParas.map((para) => <p class="cat-intro__para">{para}</p>)}
          <p class="cat-intro__para">{executionNote}</p>
        </div>
      </header>

      <!-- Tool count -->
      <div class="cat-meta">
        <span class="cat-count">{catTools.length} tool{catTools.length !== 1 ? 's' : ''}</span>
      </div>

      <!-- Tool grid -->
      <div class="tool-grid" role="list">
        {catTools.map((tool, i) => (
          <a
            href={`/tools/${tool.id}`}
            class="tool-card"
            role="listitem"
            aria-label={`${tool.name} — ${tool.category}`}
            style={`--stagger-delay: ${i * 40}ms`}
          >
            <div class="tool-card__inner">
              <div class="tool-card__name">{tool.name}</div>
              <p class="tool-card__desc">{tool.description}</p>
            </div>
          </a>
        ))}
      </div>

      <!-- Related categories -->
      {relatedCats.length > 0 && (
        <aside class="related-cats" aria-labelledby="related-cats-heading">
          <h2 id="related-cats-heading" class="related-cats__title">Related categories</h2>
          <div class="related-cats__row">
            {relatedCats.map((rc) => (
              <a href={`/category/${rc}`} class="related-cat-chip">
                {rc.charAt(0).toUpperCase() + rc.slice(1)}
              </a>
            ))}
          </div>
        </aside>
      )}
    </div>
  </section>
</BaseLayout>

<style>
  .category-page {
    padding: var(--space-8) 0 var(--space-16);
  }

  /* Breadcrumb */
  .breadcrumb {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    margin-bottom: var(--space-6);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--text-subtle);
  }

  .breadcrumb__link {
    color: var(--text-muted);
    text-decoration: none;
    transition: color var(--duration-instant) var(--ease-sharp);
  }

  .breadcrumb__link:hover {
    color: var(--text-primary);
  }

  .breadcrumb__sep {
    color: var(--text-subtle);
  }

  .breadcrumb__current {
    color: var(--text-primary);
  }

  /* Hero */
  .cat-hero {
    margin-bottom: var(--space-8);
    max-width: 720px;
  }

  .cat-title {
    font-family: var(--font-sans);
    font-size: var(--text-2xl);
    font-weight: 700;
    letter-spacing: -0.03em;
    color: var(--text-primary);
    line-height: 1.1;
    margin-bottom: var(--space-6);
  }

  .cat-sub {
    font-family: var(--font-sans);
    font-size: var(--text-md);
    color: var(--text-muted);
    line-height: 1.5;
    margin-bottom: var(--space-6);
    margin-top: 0;
  }

  .cat-intro {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }

  .cat-intro__para {
    font-family: var(--font-sans);
    font-size: var(--text-base);
    color: var(--text-muted);
    line-height: 1.6;
    margin: 0;
  }

  /* Meta */
  .cat-meta {
    margin-bottom: var(--space-4);
  }

  .cat-count {
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    color: var(--text-subtle);
  }

  /* Tool grid */
  .tool-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: var(--space-3);
    margin-bottom: var(--space-12);
  }

  .tool-card {
    display: block;
    background: var(--bg-elevated);
    border: 1px solid var(--border);
    border-radius: var(--radius-md);
    text-decoration: none;
    color: inherit;
    transition: border-color var(--duration-fast) var(--ease-sharp);
    opacity: 0;
    transform: translateY(8px);
    animation: card-reveal 200ms cubic-bezier(0, 0, 0.2, 1) forwards;
    animation-delay: var(--stagger-delay, 0ms);
  }

  @keyframes card-reveal {
    to { opacity: 1; transform: translateY(0); }
  }

  .tool-card:hover {
    border-color: var(--text-muted);
  }

  .tool-card:focus-visible {
    outline: 2px solid var(--accent-hover);
    outline-offset: 2px;
  }

  .tool-card__inner {
    padding: var(--space-4);
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }

  .tool-card__name {
    font-family: var(--font-sans);
    font-size: var(--text-base);
    font-weight: 500;
    color: var(--text-primary);
    line-height: 1.25;
  }

  .tool-card__desc {
    font-family: var(--font-sans);
    font-size: var(--text-sm);
    color: var(--text-muted);
    line-height: 1.4;
    margin: 0;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  /* Related categories */
  .related-cats {
    border-top: 1px solid var(--border-subtle);
    padding-top: var(--space-8);
  }

  .related-cats__title {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    font-weight: 400;
    color: var(--text-subtle);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    margin-bottom: var(--space-4);
  }

  .related-cats__row {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
  }

  .related-cat-chip {
    height: 32px;
    padding: 0 var(--space-4);
    background: var(--bg-elevated);
    border: 1px solid var(--border);
    border-radius: var(--radius-sm);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--text-muted);
    text-decoration: none;
    display: inline-flex;
    align-items: center;
    transition:
      border-color var(--duration-instant) var(--ease-sharp),
      color var(--duration-instant) var(--ease-sharp);
  }

  .related-cat-chip:hover {
    border-color: var(--text-muted);
    color: var(--text-primary);
  }

  .related-cat-chip:focus-visible {
    outline: 2px solid var(--accent-hover);
    outline-offset: 2px;
  }

  /* Responsive */
  @media (max-width: 1024px) {
    .tool-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  @media (max-width: 768px) {
    .tool-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 480px) {
    .tool-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
