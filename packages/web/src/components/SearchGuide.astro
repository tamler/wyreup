---
import type { SearchGuide } from '../lib/search-guides';

interface Props {
  guide: SearchGuide;
}

const { guide } = Astro.props;
---

<section class="search-guide" aria-labelledby="guide-heading">
  <h2 id="guide-heading">{guide.heading}</h2>
  <ol>
    {guide.steps.map((step) => <li>{step}</li>)}
  </ol>
  <p><strong>Supported files:</strong> {guide.formats}</p>
  <h3>A practical example</h3>
  <p>{guide.example}</p>
  <h3>Limitations and checks</h3>
  <ul>
    {guide.limitations.map((limitation) => <li>{limitation}</li>)}
  </ul>
  <nav aria-label="Related tasks and tools">
    <h3>Related tasks and tools</h3>
    <ul>
      {guide.links.map((link) => <li><a href={link.href}>{link.label}</a></li>)}
    </ul>
  </nav>
</section>

<style>
  .search-guide {
    margin-top: var(--space-8);
    padding-top: var(--space-6);
    border-top: 1px solid var(--border-subtle);
    max-width: 70ch;
    color: var(--text-muted);
    font-family: var(--font-sans);
    line-height: 1.7;
  }

  h2, h3 {
    color: var(--text-primary);
    font-weight: 600;
    line-height: 1.3;
  }

  h2 { font-size: var(--text-lg); margin: 0 0 var(--space-4); }
  h3 { font-size: var(--text-base); margin: var(--space-6) 0 var(--space-2); }
  p { margin: var(--space-3) 0; }
  ol, ul { padding-left: var(--space-6); }
  li { margin-bottom: var(--space-2); }
  a { color: var(--accent-text); text-underline-offset: 3px; }
  a:hover { color: var(--text-primary); }
</style>
